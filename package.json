{
  "name": "fixtrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "seed": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts",
    "seed:technician": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed-technician-demo.ts",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "test:unit": "tsx --test tests/unit.test.ts tests/registration-unit.test.ts tests/account-policy.test.ts tests/verification-unit.test.ts tests/workers-unit.test.ts tests/local-id-storage.test.ts tests/request-submission.test.ts tests/deployment-unit.test.ts tests/reports-ratings-unit.test.ts",
    "test:workflow": "playwright test",
    "test": "npm run test:unit && npm run test:workflow",
    "test:migration": "tsx tests/migration-preservation.ts",
    "test:turnstile-provider": "tsx --test tests/turnstile-provider.test.ts",
    "release:check": "tsx scripts/check-production-config.ts",
    "test:deployment": "tsx --test tests/deployment-unit.test.ts",
    "storage:setup": "tsx scripts/setup-private-id-storage.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "nodemailer": "10.2.1",
    "pg": "^8.20.0",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.39",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
