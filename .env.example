# Copy to .env.local (Next.js) or export into your shell. Never commit real values.
# Prisma CLI loads .env by default, NOT .env.local; export DATABASE_URL and DIRECT_URL
# before running Prisma commands, or use a private, gitignored .env file.
# For local development/testing, use only a LOCAL PostgreSQL database.
DATABASE_URL=postgresql://YOUR_LOCAL_USER:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/fixtrack_local
DIRECT_URL=postgresql://YOUR_LOCAL_USER:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/fixtrack_local
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Existing Supabase-dependent features (registration/storage/profile/realtime).
# Task 3 registration requires LOCAL Supabase Auth/private storage and its server service-role key.
# Optional photo evidence uses the existing request-photos bucket and these server credentials.
# Use local Supabase for local development; do not use production credentials for tests.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SMTP_USER=REPLACE_WITH_DEVELOPMENT_SMTP_USERNAME
SMTP_PASS=REPLACE_WITH_DEVELOPMENT_SMTP_PASSWORD

# Approved single existing account. Not a password; no account is created automatically.
# All task workflow APIs require this account to remain ACTIVE with TECHNICIAN role.
# If omitted, the approved default is tech@gmail.com; existing .env need not be edited.
TECHNICIAN_HEAD_EMAIL=tech@gmail.com

# Optional manual bootstrap only, NOT required for upgrading an existing database.
# Leave these unset unless explicitly creating a fresh development administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Tests: override both URLs to a NEW localhost database named fixtrack_test_<suffix>.
# Never enable this against an existing application database.
FIXTRACK_ALLOW_LOCAL_TESTS=0
# Playwright can use its downloaded Chromium by default.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/absolute/path/to/chromium

# Archived recovery/scratch helpers only; not needed for development or migration.
# Do not run these against existing data as part of this upgrade.
LEGACY_RESTORE_PASSWORD=
LEGACY_TEST_EMAIL=
LEGACY_TEST_PASSWORD=

# Workflow tests only: use http://127.0.0.1:55433 for the isolated storage stub.
# Keep real application storage credentials private and do not use them in automated tests.

# CLOUDFLARE TURNSTILE — paste your matching widget keys on the lines below.
# Cloudflare Dashboard → Turnstile → your widget → site key and secret key.
# These are TURNSTILE keys, not a general Cloudflare API token.
# Public site key is bundled into the browser; secret MUST remain server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=PASTE_YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY_HERE
TURNSTILE_SECRET_KEY=PASTE_YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY_HERE
# Exact comma-separated hostnames, no scheme/port. Required in production.
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
# On Vercel add these SAME variables in Production settings, then redeploy.
# A local .env is not uploaded to Vercel and does not configure the live site.
# Never put the secret key in any NEXT_PUBLIC_ variable.
# Registration ID upload reuses SUPABASE_SERVICE_ROLE_KEY and the PRIVATE registration-ids bucket.
# Documented public dummy keys for local-only testing are listed in README.md, never auto-selected.

# PRODUCTION: configure separate values in the EXISTING Vercel project's Production scope.
# Use the existing https:// production domain for NEXTAUTH_URL and NEXT_PUBLIC_BASE_URL.
# Use your hosted Supabase project API/anon/service-role values; NEVER use local keys.
# DATABASE_URL: runtime pooler URL from Supabase Connect (password URL-encoded).
# DIRECT_URL: migration-capable direct or session-mode URL, NOT transaction mode.
# Preserve existing strong NEXTAUTH_SECRET; changing it signs everyone out.
# Turnstile: real widget site/secret keys, with the existing production hostname
# allowed in BOTH Cloudflare widget settings and TURNSTILE_ALLOWED_HOSTNAMES.
# Unset all FIXTRACK_ALLOW_*, FIXTRACK_ACK_*, SEED_* and LEGACY_* production values.
# See REDEPLOYMENT_GUIDE.md. npm run release:check only checks configuration shape.
